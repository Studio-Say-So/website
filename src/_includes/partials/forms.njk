<script>
(function () {
  var endpoint = {{ forms.endpoint | dump | safe }};
  var phone = {{ forms.phone | dump | safe }};
  document.querySelectorAll("form[data-formid]").forEach(function (form) {
    var status = form.querySelector(".form-status");
    var button = form.querySelector('input[type="submit"], button[type="submit"]');
    function say(msg, ok) {
      if (!status) return;
      status.textContent = msg;
      status.dataset.state = ok ? "ok" : "error";
    }
    if (!endpoint) {
      // No backend yet: refuse rather than post to the page and lose the enquiry.
      form.addEventListener("submit", function (e) {
        e.preventDefault();
        say("This form isn't connected yet — please call " + phone + ".", false);
      });
      return;
    }
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var data = new FormData(form);
      if (button) { button.disabled = true; button.value = "Sending…"; }
      say("Sending…", true);
      fetch(endpoint, { method: "POST", body: data })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (res) {
          if (res.ok) {
            say("Thanks — we'll be in touch shortly.", true);
            // Leave only once the tags have fired. eventCallback never runs if
            // GTM is blocked, so the timeout is the guard, not the happy path.
            // Reset only on the way out: enhanced conversions read the fields
            // when the tag fires, and a cleared form gives them nothing.
            var left = false;
            function leave() {
              if (left) return;
              left = true;
              form.reset();
              window.location.href = "/thankyou-page/";
            }
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: "form_submit",
              form_id: form.dataset.formid,
              eventCallback: leave,
              eventTimeout: 2000,
            });
            setTimeout(leave, 2500);
            return;
          }
          say(res.d.error || "Something went wrong. Please call " + phone + ".", false);
        })
        .catch(function () { say("Network error. Please call " + phone + ".", false); })
        .finally(function () { if (button) { button.disabled = false; button.value = "SUBMIT"; } });
    });
  });
})();
</script>
