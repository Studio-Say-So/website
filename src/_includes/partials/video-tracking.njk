<script>
(function () {
  // The hero video is a muted autoplay background — tracking it would count
  // every visitor. Only videos with controls represent a deliberate play.
  var videos = document.querySelectorAll("video[controls]");
  if (!videos.length) return;
  window.dataLayer = window.dataLayer || [];

  videos.forEach(function (v) {
    var seen = {};
    function push(event, percent) {
      window.dataLayer.push({
        event: event,
        video_title: v.getAttribute("data-title") || document.title,
        video_url: v.currentSrc || v.src,
        video_percent: percent,
        video_provider: "self-hosted",
        video_duration: Math.round(v.duration || 0),
      });
    }
    v.addEventListener("play", function () {
      if (seen.start) return;
      seen.start = true;
      push("video_start", 0);
    });
    v.addEventListener("timeupdate", function () {
      if (!v.duration) return;
      var pct = (v.currentTime / v.duration) * 100;
      [25, 50, 75].forEach(function (mark) {
        if (pct >= mark && !seen[mark]) {
          seen[mark] = true;
          push("video_progress", mark);
        }
      });
    });
    v.addEventListener("ended", function () {
      if (seen.done) return;
      seen.done = true;
      push("video_complete", 100);
    });
  });
})();

(function () {
  // Vimeo exposes no media events across the frame boundary; it answers
  // postMessage instead, so the same four pushes are rebuilt from its replies.
  var seen = {};
  window.dataLayer = window.dataLayer || [];

  function post(frame, method, value) {
    frame.contentWindow.postMessage(JSON.stringify({ method: method, value: value }), "*");
  }

  function push(frame, event, percent, duration) {
    window.dataLayer.push({
      event: event,
      video_title: frame.title || document.title,
      video_url: frame.src.split("?")[0],
      video_percent: percent,
      video_provider: "vimeo",
      video_duration: Math.round(duration || 0),
    });
  }

  // The lightbox builds these on click, so they are found by source, not selector.
  function frameFor(source) {
    var frames = document.getElementsByTagName("iframe");
    for (var i = 0; i < frames.length; i++)
      if (frames[i].contentWindow === source && /player\.vimeo\.com/.test(frames[i].src)) return frames[i];
    return null;
  }

  window.addEventListener("message", function (e) {
    if (e.origin.indexOf("player.vimeo.com") === -1) return;
    var frame = frameFor(e.source);
    if (!frame) return;
    var d;
    try { d = typeof e.data === "string" ? JSON.parse(e.data) : e.data; } catch (err) { return; }

    // The iframe API speaks the legacy event names: playProgress, not
    // timeupdate, and finish, not ended. Only "play" is spelled the same.
    if (d.event === "ready") {
      seen = {};
      ["play", "playProgress", "finish"].forEach(function (n) { post(frame, "addEventListener", n); });
      return;
    }
    var data = d.data || {};
    if (data.duration) seen.duration = data.duration;
    if (d.event === "play" && !seen.start) {
      seen.start = true;
      push(frame, "video_start", 0, seen.duration);
    } else if (d.event === "playProgress") {
      [25, 50, 75].forEach(function (mark) {
        if (data.percent * 100 >= mark && !seen[mark]) {
          seen[mark] = true;
          push(frame, "video_progress", mark, seen.duration);
        }
      });
    } else if (d.event === "finish" && !seen.done) {
      // "finish" carries no payload, so the duration comes from playProgress.
      seen.done = true;
      push(frame, "video_complete", 100, seen.duration);
    }
  });
})();
</script>
