{% macro arrowHover() %}{#- The CTA arrow inside a .group link, so it recolours on hover. -#}
<svg class="group-hover:stroke-colorAccent-400 stroke-white" xmlns="http://www.w3.org/2000/svg" width="62.267" height="9.488" viewBox="0 0 62.267 9.488"> <g transform="translate(0 0.354)"> <line x2="61" transform="translate(0 4.335)" fill="none" stroke="inherit" stroke-width="1"/> <path d="M211.67,734.165l4.391,4.391-4.391,4.391" transform="translate(-154.5 -734.165)" fill="none" stroke="inherit" stroke-width="1"/> </g> </svg>
{% endmacro %}

{% macro scrollCue() %}{#- Circular scroll/play cue. -#}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 56 56"> <g transform="translate(-1000 -500)"> <g transform="translate(1000 500)" fill="none" stroke="#fff" stroke-width="1"> <circle cx="28" cy="28" r="28" stroke="none" /> <circle cx="28" cy="28" r="27.5" fill="none" /> </g> <path d="M9,0l9,15H0Z" transform="translate(1037.5 519) rotate(90)" fill="#fff" /> </g> </svg>
{% endmacro %}

