    <!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.10.4/ScrollTrigger.min.js"></script> -->
    <script>
    const header = document.getElementById('header');
    const hamburgerIcon = document.getElementById('hamburger');
    const navPlayButton = document.getElementById('nav-play-button');
    const navMenu = document.getElementById('nav-menu');
    const body = document.querySelector('body');
    const popupVideo = document.getElementById('popup-video');
    const playbutton = document.getElementById('play-button');
    const homeHeroCTA = document.getElementById('home-hero-cta');
    const Xbutton = document.getElementById('x-button');

    // handle nav styles on toggle
    hamburgerIcon?.addEventListener("click", () => {
        // handle navigation flyout menu
        if (navMenu.classList.contains("open")) {
            navMenu.classList.remove("open");
            navMenu.classList.add("close");
            body.classList.remove("overflow-hidden");
        } else if (navMenu.classList.contains("close")) {
            navMenu.classList.remove("close");
            navMenu.classList.add("open");
            body.classList.add("overflow-hidden");
        } else {
            return;
        }

        // handle playbutton
        if (playbutton?.classList.contains("opacity-100")) {
            if (window.scrollY > 30) {
                // fade out if page has been scrolled
                playbutton?.classList.remove("opacity-100");
                playbutton?.classList.add("opacity-0");
            }
        } else if (playbutton?.classList.contains("opacity-0")) {
            playbutton?.classList.remove("opacity-0");
            playbutton?.classList.add("opacity-100");
        }
        
        // handle home hero bottom left
        if (homeHeroCTA?.classList.contains("opacity-100")) {
            if (window.scrollY > 30) {
                // fade out if page has been scrolled
                homeHeroCTA?.classList.remove("opacity-100");
                homeHeroCTA?.classList.add("opacity-0");
            }
        } else if (homeHeroCTA?.classList.contains("opacity-0")) {
            homeHeroCTA?.classList.remove("opacity-0");
            homeHeroCTA?.classList.add("opacity-100");
        }
    });

    document.addEventListener("scroll", () => {
        // handle header background on scroll
        if (window.scrollY > 30) {
            // fade header to blur background
            header?.classList.remove("bg-transparent");
            header?.classList.add("bg-siteBackground");
            header?.classList.add("backdrop-blur-lg");
        } else {
            // fade header to bg-transparent
            header?.classList.remove("bg-siteBackground");
            header?.classList.remove("backdrop-blur-lg");
            header?.classList.add("bg-transparent");
        }

        // handle playbutton styles on scroll
        if (window.scrollY > 30) {
            // fade out play button
            playbutton?.classList.remove("opacity-100");
            playbutton?.classList.add("opacity-0");
        } else {
            // fade in play button
            playbutton?.classList.remove("opacity-0");
            playbutton?.classList.add("opacity-100");
        }

        // handle home hero social and cta styles on scroll
        if (window.scrollY > 30) {
            // fade out play button
            homeHeroCTA?.classList.remove("opacity-100");
            homeHeroCTA?.classList.add("opacity-0");
        } else {
            // fade in play button
            homeHeroCTA?.classList.remove("opacity-0");
            homeHeroCTA?.classList.add("opacity-100");
        }
    });

    // handle popup video elements on play button click
    playbutton?.addEventListener("click", async () => {
        new Promise((resolve) => {
            // close nav menu if opended
            if (navMenu.classList.contains("open")) {
                navMenu.classList.remove("open");
                navMenu.classList.add("close");
                body.classList.remove("overflow-hidden");
                setTimeout(() => {
                    resolve(()=> true);
                }, 700)
            } else {
                resolve(()=> true)
            }
        }).then((resolve) => {
            // show popup video
            popupVideo.classList.remove("hidden");
            popupVideo.classList.add("flex");

            // show x button
            Xbutton.classList.remove("hidden");
            Xbutton.classList.add("flex");

            // hide play button
            playbutton.classList.remove("flex");
            playbutton.classList.add("hidden");

            // lock scroll
            body.classList.add("overflow-hidden");
            
            resolve(()=> true)
        }).then((resolve) => {
            setTimeout(() => {
                // fade in popup video
                popupVideo.classList.remove("opacity-0");
                popupVideo.classList.add("opacity-100");

                // fade in x button
                Xbutton.classList.remove("opacity-0");
                Xbutton.classList.add("opacity-100");

                // fade out play button
                playbutton.classList.remove("opacity-100");
                playbutton.classList.add("opacity-0");

                resolve(()=> true)
            }, 50)
        })
    });

    // handle popup video elements on X button click
    Xbutton?.addEventListener("click", async () => {
        new Promise((resolve) => {
            // fade out popup video
            popupVideo.classList.remove("opacity-100");
            popupVideo.classList.add("opacity-0");

            // fade out x button
            Xbutton.classList.remove("opacity-100");
            Xbutton.classList.add("opacity-0");

            // fade in play button
            playbutton.classList.remove("opacity-0");
            playbutton.classList.add("opacity-100");
            resolve(()=> true)
        }).then((resolve) => {
            setTimeout(() => {
                // hide popup video
                popupVideo.classList.remove("flex");
                popupVideo.classList.add("hidden");

                // hide x button
                Xbutton.classList.remove("flex");
                Xbutton.classList.add("hidden");

                // show play button
                playbutton.classList.remove("hidden");
                playbutton.classList.add("flex");

                // unlock scroll
                body.classList.remove("overflow-hidden");
                resolve(()=> true)
            }, 700)
        })
    });
</script>
