<link rel='stylesheet' id='init_style-css' href='/wp-content/themes/studio-say-so/dist/css/style.css?ver=1.0.0' media='all' />
{%- if extraStyles %}
{{ extraStyles | safe }}
{%- endif %}
{%- if inlineStyles %}
{{ inlineStyles | safe }}
{%- endif %}
{%- if headScripts %}
{{ headScripts | safe }}
{%- endif %}

{% include "partials/tracking-head.njk" %}
</head>

