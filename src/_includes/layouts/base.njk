Suite 305<br />
Orlando, FL 32801</a></p>
</div></div>            </div>

            <div class="flex md:flex-1 flex-col md:flex-row md:ml-auto gap-12 lg:gap-20 justify-between md:justify-end min-w-fit">
                <!-- Footer Navigation 1 -->
                <ul class="space-y-4">
                    <li><a href="/industries/healthcare/">Healthcare</a></li><li><a href="/industries/finance/">Finance</a></li><li><a href="/industries/education/">Education</a></li>                </ul>

                <!-- Footer Navigation 2 -->
                <ul class="space-y-4">
                    <li><a href="/work/">Work</a></li><li><a href="/about-us/">About Us</a></li><li><a href="/privacy-policy/">Privacy Policy</a></li>                </ul>

                <!-- Contact -->
                <div class="space-y-4 text-colorAccent-400">
                    <a href="/contact">Contact Us</a>
                    <p>407-839-6452</p>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div class="mt-8 md:ml-16">
            <span>&copy;2026 Studio Say So. All rights reserved.</span>        </div>
    </div>

</footer>
