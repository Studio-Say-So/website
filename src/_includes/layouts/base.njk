<header id="header" class="text-white py-8 fixed w-screen z-50 bg-transparent transition-colors duration-500 bg-opacity-75">
        <nav id="nav-menu" class="w-screen h-screen absolute z-10 bg-colorAccent-700 close top-0 right-0 
                transition duration-500 flex flex-col items-center justify-center gap-6 lg:gap-10 text-4xl lg:text-[66px] font-bold pb-10 lg:pb-0">
            <a class="hover:scale-105 duration-300 transition-transform" href="/work/">Work</a><a class="hover:scale-105 duration-300 transition-transform" href="/industries/">Industries</a><a class="hover:scale-105 duration-300 transition-transform" href="/about-us/">About Us</a><a class="hover:scale-105 duration-300 transition-transform" href="/contact-us/">Contact Us</a>        </nav>

        <div class="px-6 md:px-12 grid grid-cols-3 items-center relative z-30">
            <!-- Logo Icon -->
            <a class="flex justify-start items-center" href="/">
                <img src="/wp-content/uploads/2022/12/footer-logo.svg" class="attachment-full size-full" alt="" decoding="async" />            </a>

            <!-- Logo Text -->
            <a class="flex justify-center items-center" href="/">
                <img src="/wp-content/uploads/2022/12/footer-logo-text.svg" class="attachment-full size-full" alt="" decoding="async" />            </a>

            <!-- Hamburger Icon -->
            <div class="flex justify-end items-center">
                <button id="hamburger" class="cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="18" viewBox="0 0 25 18">
                        <g id="Group_5" data-name="Group 5" transform="translate(-306.5 -123.5)">
                            <line id="Line_1" data-name="Line 1" x2="16" transform="translate(315.5 124.5)" fill="none" stroke="#fff"
                                stroke-width="2" />
                            <line id="Line_2" data-name="Line 2" x2="25" transform="translate(306.5 132.5)" fill="none" stroke="#fff"
                                stroke-width="2" />
                            <line id="Line_3" data-name="Line 3" x2="25" transform="translate(306.5 140.5)" fill="none" stroke="#fff"
                                stroke-width="2" />
                        </g>
                    </svg>
                </button>
            </div>
        </div>
    </header>

{{ content | safe }}

