<!DOCTYPE html>
<html lang="en-US">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{%- if description %}
<meta name="description" content="{{ description }}">
{%- endif %}
{%- if robots %}
<meta name="robots" content="{{ robots }}">
{%- endif %}
{%- if canonical %}
<link rel="canonical" href="{{ canonical }}">
{%- endif %}
{%- if ogTags %}
