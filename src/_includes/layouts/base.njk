<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {{ pageTitle }}
    </title>
    {%- if description %}
    <meta name="description" content="{{ description }}">
    {%- endif %} {%- if build.preview %}
    <meta name="robots" content="noindex, nofollow">
    {%- elif robots %}
    <meta name="robots" content="{{ robots }}">
    {%- endif %} {%- if canonical %}
    <link rel="canonical" href="{{ canonical }}">
    {%- endif %}{% include "partials/meta.njk" %} {%- if jsonld %}
    <script type="application/ld+json">
{{ jsonld | safe }}
</script>
    {%- endif %}
    <link rel='stylesheet' id='init_style-css' href='/assets/css/style.css?ver=1.0.0' media='all' />
    <link rel="stylesheet" href="/assets/vendor/splide/splide-core.min.css">
    <link rel="stylesheet" href="/assets/css/carousel.css">
    <link rel="stylesheet" href="/assets/css/lightbox.css">
    <link rel="stylesheet" href="/assets/css/hero.css">
    <link rel="icon" href="/assets/img/favicon.png" sizes="192x192">
    <link rel="apple-touch-icon" href="/assets/img/favicon.png">
    {%- if site.gtmId %}
    <link rel="stylesheet" href="/assets/css/consent.css">
    {%- endif %}
    {%- if extraStyles %} {{ extraStyles | safe }} {%- endif %} {%- if inlineStyles %} {{ inlineStyles | safe }} {%- endif %}
    {% include "partials/consent.njk" %}
    {% include "partials/tracking-head.njk" %}
  </head>
  <body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    {%- if site.gtmId %}
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtmId }}"
height="0" width="0" style="display:none;visibility:hidden">
      </iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    {%- endif %}
    <div class="relative" style="overflow-x:hidden;">
      <header id="header" class="text-white py-8 fixed w-screen z-50 bg-transparent transition-colors duration-500 bg-opacity-75">
        <nav id="nav-menu" class="w-screen h-screen absolute z-10 bg-colorAccent-700 close top-0 right-0 
                transition duration-500 flex flex-col items-center justify-center gap-6 lg:gap-10 text-4xl lg:text-[66px] font-bold pb-10 lg:pb-0">
          <a class="hover:scale-105 duration-300 transition-transform" href="/work/">Work</a><a class="hover:scale-105 duration-300 transition-transform" href="/industries/">Industries</a><a class="hover:scale-105 duration-300 transition-transform" href="/about-us/">About Us</a><a class="hover:scale-105 duration-300 transition-transform" href="/contact-us/">Contact Us</a>
        </nav>
        <div class="px-6 md:px-12 grid grid-cols-3 items-center relative z-30">
          <!-- Logo Icon -->
          <a class="flex justify-start items-center" href="/"> <img src="/assets/img/footer-logo.svg" alt="Studio Say So" decoding="async" width="48" height="51" loading="eager" fetchpriority="high" /> </a>
          <!-- Logo Text -->
          <a class="flex justify-center items-center" href="/"> <img src="/assets/img/footer-logo-text.svg" alt="" decoding="async" width="179" height="13" loading="eager" fetchpriority="high" /> </a>
          <!-- Hamburger Icon -->
          <div class="flex justify-end items-center">
            <button id="hamburger" class="cursor-pointer">
              <svg xmlns="http://www.w3.org/2000/svg" width="25" height="18" viewBox="0 0 25 18">
                        <g transform="translate(-306.5 -123.5)">
                            <line x2="16" transform="translate(315.5 124.5)" fill="none" stroke="#fff"
                                stroke-width="2" />
                            <line x2="25" transform="translate(306.5 132.5)" fill="none" stroke="#fff"
                                stroke-width="2" />
                            <line x2="25" transform="translate(306.5 140.5)" fill="none" stroke="#fff"
                                stroke-width="2" />
                        </g>
                    </svg>
            </button>
          </div>
        </div>
      </header>
      <main>
        {{ content | safe }}
      </main>
      <footer class="border-t-colorWhite border-t py-12 px-6 md:px-12 md:py-16 bg-siteBackground">
        <div class=" text-white">
          <div class="flex flex-col md:flex-row text-xl gap-10 md:gap-2">
            <!-- Logo and address -->
            <div class="flex flex-col md:flex-row gap-4 md:flex-1">
              <div class="-mt-4">
                <img src="/assets/img/footer-logo.svg" alt="Studio Say So" decoding="async" loading="lazy" width="48" height="51" />
              </div>
              <div class="flex-1 space-y-6">
                <div class="pt-1.5">
                  <img src="/assets/img/footer-logo-text.svg" alt="" decoding="async" loading="lazy" width="179" height="13" />
                </div>
                <div class="text-colorAccent-400 text-lg">
                  <p>
                    <a href="https://www.google.com/maps/place/Studio+Say+So,+Inc./@28.5528741,-81.3826884,17z/data=!3m1!4b1!4m5!3m4!1s0x88e77b1857055a6d:0x4ee61473aa4e10c7!8m2!3d28.5528741!4d-81.3804997" target="_blank" rel="noopener">62 West Colonial Dr.<br /> Suite 305<br /> Orlando, FL 32801</a>
                  </p>
                </div>
              </div>
            </div>
            <div class="flex md:flex-1 flex-col md:flex-row md:ml-auto gap-12 lg:gap-20 justify-between md:justify-end min-w-fit">
              <!-- Footer Navigation 1 -->
              <ul class="space-y-4">
                <li>
                  <a href="/industries/healthcare/">Healthcare</a>
                </li>
                <li>
                  <a href="/industries/finance/">Finance</a>
                </li>
                <li>
                  <a href="/industries/education/">Education</a>
                </li>
              </ul>
              <!-- Footer Navigation 2 -->
              <ul class="space-y-4">
                <li>
                  <a href="/work/">Work</a>
                </li>
                <li>
                  <a href="/about-us/">About Us</a>
                </li>
                <li>
                  <a href="/privacy-policy/">Privacy Policy</a>
                </li>
              </ul>
              <!-- Contact -->
              <div class="space-y-4 text-colorAccent-400">
                <a href="/contact-us/">Contact Us</a>
                <p>
                  407-839-6452
                </p>
              </div>
            </div>
          </div>
          <!-- Copyright -->
          <div class="mt-8 md:ml-16">
            <span>&copy;2026 Studio Say So. All rights reserved.</span>
          </div>
        </div>
      </footer>
    </div>
    <!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.10.4/gsap.min.js"></script> -->
    <!-- <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.10.4/ScrollTrigger.min.js"></script> -->
    <script>
    const header = document.getElementById('header');
    const hamburgerIcon = document.getElementById('hamburger');
    const navPlayButton = document.getElementById('nav-play-button');
    const navMenu = document.getElementById('nav-menu');
    const body = document.querySelector('body');
    const homeHeroCTA = document.getElementById('home-hero-cta');


    // handle nav styles on toggle
    hamburgerIcon?.addEventListener("click", () => {
        // handle navigation flyout menu
        if (navMenu.classList.contains("open")) {
            navMenu.classList.remove("open");
            navMenu.classList.add("close");
            body.classList.remove("overflow-hidden");
        } else if (navMenu.classList.contains("close")) {
            navMenu.classList.remove("close");
            navMenu.classList.add("open");
            body.classList.add("overflow-hidden");
        } else {
            return;
        }
        
        // handle home hero bottom left
        if (homeHeroCTA?.classList.contains("opacity-100")) {
            if (window.scrollY > 30) {
                // fade out if page has been scrolled
                homeHeroCTA?.classList.remove("opacity-100");
                homeHeroCTA?.classList.add("opacity-0");
            }
        } else if (homeHeroCTA?.classList.contains("opacity-0")) {
            homeHeroCTA?.classList.remove("opacity-0");
            homeHeroCTA?.classList.add("opacity-100");
        }
    });

    document.addEventListener("scroll", () => {
        // handle header background on scroll
        if (window.scrollY > 30) {
            // fade header to blur background
            header?.classList.remove("bg-transparent");
            header?.classList.add("bg-siteBackground");
            header?.classList.add("backdrop-blur-lg");
        } else {
            // fade header to bg-transparent
            header?.classList.remove("bg-siteBackground");
            header?.classList.remove("backdrop-blur-lg");
            header?.classList.add("bg-transparent");
        }

        // handle home hero social and cta styles on scroll
        if (window.scrollY > 30) {
            // fade out play button
            homeHeroCTA?.classList.remove("opacity-100");
            homeHeroCTA?.classList.add("opacity-0");
        } else {
            // fade in play button
            homeHeroCTA?.classList.remove("opacity-0");
            homeHeroCTA?.classList.add("opacity-100");
        }
    });

</script>
