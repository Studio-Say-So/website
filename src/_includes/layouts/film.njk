---
layout: "layouts/base.njk"
extraStyles: |
  <link rel="stylesheet" href="/assets/css/film.css">
---
{% import "macros/ui.njk" as ui %}
<section
        class="w-screen h-screen flex flex-col items-center justify-center text-white relative"
        style="background-image: url({{ film.heroImage }}); background-position: center; background-size: cover;">
  <div class="relative z-20 flex flex-col items-center">
    <h1 class="text-5xl lg:text-6xl font-bold font-display leading-[.95] max-w-[21ch] mb-3 text-center">
      {{ title }}
    </h1>
    <h2 class="max-w-[28ch] mb-10 text-center">
      {{ film.client if (film.client and film.client != title) else "Film" }}
    </h2>
    <a href="{{ film.video }}" class="block opacity-100 transition duration-500 w-[56px] h-[56px]" rel="lightbox" aria-label="Play {{ title }}" data-video-title="{{ title }}">{{ ui.scrollCue() }}</a>
  </div>
  <a href="#film" class="absolute bottom-12 right-1/2 z-20 block opacity-100 transition translate-x-1/2 animate-bounce duration-700">{{ ui.arrowDown() }} </a>
  <div class="absolute w-full h-full z-0 bg-siteBackground bg-blend-multiply bg-opacity-75 top-0 right-0">
  </div>
</section>
<section id="film" class="film-body flex flex-col items-center justify-center pt-16 relative my-16">
  <div class="custom-container flex flex-col items-center justify-center">
    <h2 class="heading-underline text-white font-display text-5xl max-w-[26ch] mb-6 text-center">
      {{ title }}
    </h2>
    <div class="text-colorText-body max-w-[80ch] text-center">{{ film.summary }}</div>
    <dl class="text-colorText-body film-meta">
      {%- if film.client %}
      <div>
        <dt>Client</dt>
        <dd>{{ film.client }}</dd>
      </div>
      {%- endif %}
      {%- if film.year %}
      <div>
        <dt>Year</dt>
        <dd>{{ film.year }}</dd>
      </div>
      {%- endif %}
      {%- if film.runtime %}
      <div>
        <dt>Runtime</dt>
        <dd>{{ film.runtime }}</dd>
      </div>
      {%- endif %}
      {%- if film.sector %}
      <div>
        <dt>Sector</dt>
        <dd><a class="hover:text-colorAccent-400 transition duration-200" href="{{ film.sectorUrl }}">{{ film.sector }}</a></dd>
      </div>
      {%- endif %}
    </dl>
    <div class="link-group mt-12">
      <a class="px-5 py-4 group uppercase font-bold flex gap-4 items-center w-fit hover:shadow hover:translate-x-1 transition duration-200" href="{{ film.video }}" rel="lightbox" data-video-title="{{ title }}"><span class="text-white group-hover:text-colorAccent-400">Watch the film</span>{{ ui.arrow() }}</a>
    </div>
  </div>
  <div class="w-[206px] lg:w-[400px] -z-10 opacity-50 absolute right-0 hidden lg:block translate-x-1/2 -translate-y-1/2 top-[60%]">
    {{ ui.blob() }}
  </div>
</section>
{{ content | trim | safe }}
<section class="custom-container">
  <div class="flex flex-col items-center gap-8 relative border-colorAccent-border py-12 my-12">
    <h2 class="text-white text-4xl font-display max-w-[26ch] text-center">
      {{ film.cta or "Discuss Your Project With Us" }}
    </h2>
    <div class="link-group">
      <a class="px-5 py-4 bg-colorAccent-700 uppercase font-bold text-white flex gap-4 items-center w-fit hover:shadow hover:translate-x-1 transition duration-200 button" href="/contact-us/"><span>Let's Talk</span>{{ ui.arrow() }}</a>
    </div>
  </div>
</section>
<section class="custom-container mb-28">
  <div class="flex flex-col items-center gap-6">
    <a class="font-display text-white flex gap-4 items-center w-fit hover:translate-x-1 transition duration-200 button" href="/work/"><span>See more of our work</span>{{ ui.arrow() }}</a>
  </div>
</section>
