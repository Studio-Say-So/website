        { name: "phone",   label: "Phone Number",             required: true, max: 40,   type: "tel",   autocomplete: "tel" },
        { name: "email",   label: "Email Address",            required: true, max: 200,  type: "email", autocomplete: "email" },
        { name: "company", label: "Company Name",             required: true, max: 200,  autocomplete: "organization" },
        { name: "budget",  label: "Estimated Budget",         required: true, max: 100 },
        { name: "message", label: "Brief us on your project", required: true, max: 5000, type: "textarea", rows: 10 }
      ], "SUBMIT", forms) }}
