      <h1 class="text-5xl lg:text-6xl font-bold font-display leading-[.95] max-w-[21ch] mb-12">
        Let’s make your audience feel something.
      </h1>
    </div>
    <div class="w-[42vw] h-[42vw] -z-10 opacity-50 absolute right-0 -top-12 hidden xl:block translate-x-1/2 -translate-y-1/2">
      {{ ui.blob() }}
    </div>
  </section>
  <section class="custom-container grid grid-cols-1 lg:grid-cols-2 gap-12 mb-32 ">
    <div class="text-white [&_h2]:text-[22px] [&_h2]:font-display [&_h2]:mb-2 [&_p]:max-w-[70ch]">
